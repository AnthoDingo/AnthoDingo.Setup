{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/AnthoDingo.Setup",
          "files": [ "AnthoDingo.Setup.csproj" ]
        },
        {
          "src": "../src/AnthoDingo.Setup.Providers",
          "files": [ "AnthoDingo.Setup.Providers.csproj" ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      { "files": [ "**/*.{md,yml}" ], "exclude": [ "_site/**" ] },
      { "files": [ "README.md", "README.en.md", "README.de.md" ], "src": ".." }
    ],
    "resource": [
      { "files": [ "images/**" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "AnthoDingo.Setup",
      "_appTitle": "AnthoDingo.Setup",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/AnthoDingo/AnthoDingo.Setup",
        "branch": "main"
      }
    }
  }
}
